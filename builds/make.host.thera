#-- make.host for AMD Lockhart
#-- Compiler and flags for different build type
CXX               = $(HOME)/util/ompi/bin/mpicxx
GPUCXX           ?= hipcc



CXXFLAGS_DEBUG    = -g -O0 -std=c++17
CXXFLAGS_OPTIMIZE = -g -Ofast -std=c++17 -L

GPUFLAGS_OPTIMIZE = -std=c++17 --offload-arch=gfx90a  -munsafe-fp-atomics 
GPUFLAGS_DEBUG    = -g -O0 -std=c++17 --offload-arch=gfx90a 
HIPCONFIG	  = $(shell hipconfig -C)

OMP_NUM_THREADS   = 7
#-- How to launch job
JOB_LAUNCH        = srun -u -n 1 -c 8

#-- Library
MPI_ROOT          = $(HOME)/util/ompi
HDF5_ROOT         = $(HDF5_DIR)
#FFTW_ROOT         = $(shell dirname $(FFTW_DIR))
GOOGLETEST_ROOT := $(if $(GOOGLETEST_ROOT),$(GOOGLETEST_ROOT),$(OLCF_GOOGLETEST_ROOT))

#-- Use GPU-aware MPI
MPI_GPU           = -DMPI_GPU